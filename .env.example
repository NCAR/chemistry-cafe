# ─────────────────────────────────────────────────────────────
# Chemistry Cafe — environment variables (template)
#
# Copy this file to:
#   • .env          (repo root) → used by Docker Compose (the usual path)
#   • backend/.env  (optional)  → used ONLY when running the backend
#                                 WITHOUT Docker; set MYSQL_SERVER=localhost
#
# The values below are working local-dev defaults. You only need to fill
# in the two Google OAuth secrets. .env and backend/.env are git-ignored.
# ─────────────────────────────────────────────────────────────

# --- Google OAuth (required, no default) ---
# From a Google Cloud OAuth 2.0 client. Add
# http://localhost:8080/signin-google to the client's
# "Authorized redirect URIs" for local testing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- MySQL credentials (must match the database) ---
MYSQL_USER=chemistrycafedev
MYSQL_PASSWORD=chemistrycafe
MYSQL_DATABASE=chemistry_db

# --- MySQL connection ---
# Docker Compose: the DB host is the compose service name, "mysql".
# Backend outside Docker: set this to "localhost".
MYSQL_SERVER=mysql
MYSQL_PORT=3306

# --- URLs ---
# Where the frontend is served (backend CORS + OAuth redirects).
FRONTEND_HOST=http://localhost:5173
# Path prefix the backend is hosted under (e.g. "/api/"). "/" for local.
BACKEND_BASE_URL=/
